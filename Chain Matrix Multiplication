#include <iostream>
#include <vector>
#include <climits>

using namespace std;

void printOptimalOrder(const vector<vector<int>>& split, int i, int j) {
    if (i == j) {
        cout << "A" << i;
        return;
    }

    cout << "(";
    printOptimalOrder(split, i, split[i][j]);
    cout << " x ";
    printOptimalOrder(split, split[i][j] + 1, j);
    cout << ")";
}

int main() {
    int n;

    cout << "Enter number of dimensions: ";
    cin >> n;

    if (n < 2) {
        cout << "At least 2 dimensions are required." << endl;
        return 0;
    }

    vector<long long> dimensions(n);

    cout << "Enter dimensions: ";
    for (int i = 0; i < n; i++) {
        cin >> dimensions[i];
    }

    // Number of matrices = n - 1
    int matrices = n - 1;

    vector<vector<long long>> dp(matrices + 1,
                                 vector<long long>(matrices + 1, 0));

    vector<vector<int>> split(matrices + 1,
                              vector<int>(matrices + 1, 0));

    for (int chainLength = 2; chainLength <= matrices; chainLength++) {
        for (int i = 1; i <= matrices - chainLength + 1; i++) {
            int j = i + chainLength - 1;

            dp[i][j] = LLONG_MAX;

            for (int k = i; k < j; k++) {
                long long cost =
                    dp[i][k] +
                    dp[k + 1][j] +
                    dimensions[i - 1] * dimensions[k] * dimensions[j];

                if (cost < dp[i][j]) {
                    dp[i][j] = cost;
                    split[i][j] = k;
                }
            }
        }
    }

    cout << "\nMinimum number of scalar multiplications: "
         << dp[1][matrices] << endl;

    cout << "Optimal parenthesization: ";
    printOptimalOrder(split, 1, matrices);
    cout << endl;

    return 0;
}
